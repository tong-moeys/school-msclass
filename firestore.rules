rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Teacher profiles
    match /teachers/{teacherId} {
      allow read, write: if request.auth != null;
    }

    // Classes data: students, scores, attendance, honor photos, remarks
    // Allows public read so QR code verification and reports can be viewed
    match /classes/{classId}/{allChildren=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback for other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

